# .env is for SECRETS and channel-enable flags only.
# Non-secret runtime config (bot name, allowed senders, max sessions, timezone,
# etc.) lives in data/config.json — see README for the schema, or run
# `bun run setup` to generate both files interactively.

# --- Secrets / tokens ---

# Telegram
TELEGRAM_BOT_TOKEN=

# Slack (both must be set; uses Socket Mode — no public webhook needed)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Anthropic (only needed if not using `claude` CLI's OAuth login). Setting this
# also turns on the daily_usd_budget check (metered billing).
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=                  # `claude setup-token`; written by `bun run container login`

# Google OAuth (Gmail, Sheets, etc). Create a "Desktop app" OAuth client at
# https://console.cloud.google.com/apis/credentials then put the IDs here.
# Refresh token is stored in macOS Keychain (service: marsclaw) or data/secrets/ on Linux, not in .env.
# Run `bun run marsclaw google login` after setting these.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Channel-enable flags ---

# WhatsApp (Baileys, QR scan on first run; auth saved to data/whatsapp-auth/)
# MARSCLAW_WHATSAPP=1

# Provider — written here by `bun run setup` / `bun run provider`. Restart after changing.
# AGENT_PROVIDER=gemini                     # gemini | claude

# --- Optional env overrides (override data/config.json when set) ---

# MARSCLAW_BOT_NAME=Mars
# MARSCLAW_OWNER_NAME=                      # what the bot calls you
# MARSCLAW_OWNER_PHONE=                     # your WhatsApp number, digits only
# MARSCLAW_WHATSAPP_ALLOWED_JIDS=...       # comma-list, empty = allow all
# MARSCLAW_TELEGRAM_ALLOWED_CHATS=...      # comma-list of chat ids, empty = allow all
# MARSCLAW_SLACK_ALLOWED_USERS=...         # comma-list of Slack user ids, empty = allow all
# MARSCLAW_ALLOW_MUTATING_TOOLS=0          # 1 = let the agent send mail / write Sheets / etc.
# MARSCLAW_ALLOW_SHELL=0                    # 1 = give the agent shell/Bash (reopens exfil risk)
# MARSCLAW_ALLOW_WEB=0                      # 1 = allow WebFetch/WebSearch (network egress channel)
# MARSCLAW_ALLOWED_WEB_DOMAINS=...         # comma-list of hosts WebFetch may hit, e.g. "wikipedia.org,*.gov"
# MARSCLAW_MUTATION_APPROVAL=off           # all = per-call approval code for Google writes
# MARSCLAW_EGRESS_MODE=off                 # gateway (only relaxes allow-list with MARSCLAW_EGRESS_ENFORCED=1)
# MARSCLAW_RUNTIME=in-process              # container = isolated agent (see docs/container-runtime.md)
# MARSCLAW_ALERT_THREAD=telegram:123       # where audit-density alerts go (auto-picked if one owner)
# MARSCLAW_HEALTH_PORT=                    # enable 127.0.0.1 /health on this port
# MARSCLAW_AUDIT_LOG=logs/audit.log         # path to the append-only security audit log
# MARSCLAW_ALLOWED_PATHS=/Users/...        # comma-list, default = cwd
# MARSCLAW_MAX_SESSIONS=20
# MARSCLAW_CLAUDE_IDLE_MS=900000
# MARSCLAW_CLAUDE_MAX_SESSION_AGE_MS=14400000
# MARSCLAW_AGENT_TIMEOUT_MS=300000
# MARSCLAW_RATE_LIMIT_PER_MINUTE=10
# MARSCLAW_RATE_LIMIT_PER_HOUR=60
# MARSCLAW_DAILY_USD_BUDGET=0              # metered API key only
# MARSCLAW_TIMEZONE=UTC                     # IANA tz, e.g. Asia/Colombo — agent's "now"
# MARSCLAW_LOCATION=                        # e.g. "Colombo, Sri Lanka" — personalization context
# MARSCLAW_VOICE=1
# LOG_LEVEL=info                              # debug | info | warn | error | fatal

# --- Container runtime (set by `bun run container enable` / `login`) ---

# LLM_PROXY_SESSION_TOKEN=                  # the only Anthropic credential the container sees
# MARSCLAW_MCP_TOKEN=                       # host HTTP MCP auth (unset = no auth!)
# EGRESS_PROXY_TOKEN=                       # optional egress-gateway auth (not minted automatically)
# MARSCLAW_DOCKER_BIN=/opt/homebrew/bin/docker

# --- Gemini ---

# GEMINI_MODEL=gemini-2.5-flash

# --- Voice sidecar URLs (only if you've customised them) ---

# WHISPER_URL=http://127.0.0.1:9000
# WHISPER_MODEL=base                          # tiny | base | small | medium | large
# KOKORO_URL=http://127.0.0.1:9001
# KOKORO_VOICE=af_heart
# KOKORO_FORMAT=ogg                           # ogg (voice note) | mp3 | wav

# --- Path / binary overrides ---

# GEMINI_BIN=gemini
# CLAUDE_BIN=claude
# MARSCLAW_DB=data/marsclaw.db
# MARSCLAW_CONFIG=data/config.json
# MARSCLAW_WHATSAPP_AUTH=data/whatsapp-auth
